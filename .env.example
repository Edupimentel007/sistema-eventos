# Copie os valores para o ambiente do processo. Este arquivo não contém segredos.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/events.sqlite
APP_BASE_URL=http://127.0.0.1:3000
BRAND_NAME=Jardim
CONTACT_EMAIL=
CONTACT_PHONE=
DEFAULT_TIMEZONE=America/Sao_Paulo
# Em produção com HTTPS, defina COOKIE_SECURE=true.
COOKIE_SECURE=false
# Arquivos privados devem ficar fora de public/ e no mesmo volume de backup do banco.
MEDIA_ROOT=data/uploads
PRIVATE_UPLOAD_DIR=data/private_uploads
# Mantenha o processo ativo para processar mensagens agendadas.
NOTIFICATIONS_WORKER=true
# Configure apenas no servidor quando contratar cada canal. Veja docs/MENSAGENS.md.
RESEND_API_KEY=
RESEND_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
